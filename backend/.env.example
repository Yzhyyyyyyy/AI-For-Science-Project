# AI学术审查系统 v5.1 后端配置模板
# 请复制本文件为 backend\.env 后填写真实配置

# OpenAI-compatible API 配置（必填）
DASHSCOPE_API_KEY=YOUR_API_KEY_HERE
QWEN_BASE_URL=https://api.example.com/openai/v1
QWEN_TEXT_MODEL=qwen-plus-latest

# 可选：审计 Agent
AUDIT_MODEL=qwen-plus-latest
AUDIT_MAX_TOKENS=4096
AUDIT_COMPACT_MAX_TOKENS=2048
AUDIT_REEVALUATION_MAX_ROUNDS=1

# 服务配置
HOST=127.0.0.1
PORT=8000
REVIEW_TIMEOUT_SECONDS=600
MAX_CONCURRENT_REVIEWS=2
MAX_UPLOAD_BYTES=52428800
